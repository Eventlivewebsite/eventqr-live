generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum EventType {
  WEDDING
  BIRTHDAY
  ENGAGEMENT
  ANNIVERSARY
  BABY_SHOWER
  CORPORATE
  CUSTOM
  OTHER
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ACTIVE
  COMPLETED
  ARCHIVED
  EXPIRED
}

enum AccessMode {
  PUBLIC
  PRIVATE
}

enum AlbumType {
  PRE_WEDDING
  HALDI
  MEHENDI
  WEDDING
  RECEPTION
  FAMILY
  CAKE_CUTTING
  KEYNOTE
  CUSTOM
}

enum MediaType {
  PHOTO
  VIDEO
}

enum ClientPlan {
  FREE
  STANDARD
  PREMIUM
  ENTERPRISE
}

model User {
  id           String    @id @default(cuid())
  userId       String    @unique // Admin unique username
  ownerName    String    // Owner Name
  companyName  String?   // Studio Name
  name         String    // Display Name
  email        String    @unique
  phone        String?   @unique
  passwordHash String

  role         UserRole  @default(ADMIN)

  avatar       String?
  isActive     Boolean   @default(true)
  isDeleted    Boolean   @default(false)

  lastLogin    DateTime?
  updatedBy    String?   // Super admin ID who modified this admin

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  events       Event[]
  clients      Client[]
  accounts     Account[]
  sessions     Session[]
  auditLogs    AuditLog[] @relation("ActorAuditLogs")

  @@index([email, isActive])
  @@index([userId, isActive])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String

  accessToken           String?
  refreshToken          String?
  idToken               String?

  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?

  scope                 String?
  password              String?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

model Client {
  id                   String     @id @default(cuid())

  adminId              String
  admin                User       @relation(fields: [adminId], references: [id], onDelete: Cascade)

  companyName          String?
  contactPerson        String

  email                String
  loginId              String?    @unique

  passwordHash         String?

  viewerLoginRequired  Boolean    @default(false)

  plan                 ClientPlan @default(PREMIUM)
  phone                String

  address              String?
  city                 String?
  state                String?
  country              String?

  storageDays          Int        @default(15)
  storageLimitGB       Int        @default(50)
  storageUsedGB        Float      @default(0)

  isActive             Boolean    @default(true)
  isDeleted            Boolean    @default(false)

  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  events               Event[]

  @@index([adminId, isDeleted])
}

model Event {
  id               String          @id @default(cuid())

  adminId          String
  admin            User            @relation(fields: [adminId], references: [id], onDelete: Restrict)

  clientId         String
  client           Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)

  title            String

  brideName        String?
  groomName        String?
  clientName       String?

  slug             String          @unique

  type             EventType
  status           EventStatus     @default(ACTIVE)

  approvedBy       String?
  approvedAt       DateTime?
  rejectionReason  String?

  accessMode       AccessMode      @default(PUBLIC)
  pinCode          String?

  retentionDays    Int             @default(15)
  expiryDate       DateTime?
  isDeleted        Boolean         @default(false)
  deletedAt        DateTime?

  eventDate        DateTime?
  location         String?

  coverImage       String?
  logo             String?
  themeColor       String?         @default("#9333EA")

  qrEnabled        Boolean         @default(true)
  guestBook        Boolean         @default(true)
  isLive           Boolean         @default(true)
  allowGuestUpload Boolean         @default(true)

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  albums           Album[]
  customFields     CustomField[]
  analytics        EventAnalytics?
  settings         EventSettings?
  timelines        EventTimeline[]

  @@index([slug, status, isDeleted])
  @@index([clientId, isDeleted])
  @@index([adminId])
}

model CustomField {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  fieldName  String
  fieldValue String

  createdAt  DateTime @default(now())

  @@unique([eventId, fieldName])
  @@index([eventId])
}

model EventSettings {
  id                String   @id @default(cuid())
  eventId           String   @unique
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  subtitle          String?  @default("Forever Begins Today")
  storyVideoUrl     String?
  highlightUrl      String?

  showCountdown     Boolean  @default(true)
  showHighlights    Boolean  @default(true)
  showTrending      Boolean  @default(true)
  showTimeline      Boolean  @default(true)
  allowDownloads    Boolean  @default(true)
  allowLikes        Boolean  @default(true)
  showWatermark     Boolean  @default(true)
  watermarkText     String?
  watermarkPosition String?  @default("BOTTOM_RIGHT")
  watermarkOpacity  Float?   @default(0.8)

  videoHubTitle     String?  @default("A & S FILMS")
  videoHubSubtitle  String?  @default("Relive Every Beautiful Moment")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model EventTimeline {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  title      String
  timeText   String
  statusText String   @default("UPCOMING")
  sortOrder  Int      @default(0)

  createdAt  DateTime @default(now())

  @@index([eventId, sortOrder])
}

model Album {
  id          String    @id @default(cuid())

  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  title       String
  slug        String

  type        AlbumType @default(CUSTOM)

  coverImage  String?
  description String?

  sortOrder   Int       @default(0)
  isHidden    Boolean   @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  media       Media[]

  @@unique([eventId, slug])
  @@index([eventId, isHidden, sortOrder])
}

model Media {
  id             String    @id @default(cuid())

  albumId        String
  album          Album     @relation(fields: [albumId], references: [id], onDelete: Cascade)

  originalPath   String
  compressedPath String?
  thumbnailPath  String?

  fileName       String
  fileExtension  String
  mimeType       String

  mediaType      MediaType

  width          Int?
  height         Int?

  duration       Int?

  fileSize       Int

  isApproved     Boolean   @default(true)
  isFavourite    Boolean   @default(false)
  isWatermarked  Boolean   @default(false)
  isCompressed   Boolean   @default(false)
  isDeleted      Boolean   @default(false)

  uploadedAt     DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([albumId, isDeleted])
  @@index([albumId, mediaType])
  @@index([albumId, isApproved])
}

model EventAnalytics {
  id             String   @id @default(cuid())
  eventId        String   @unique
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  totalScans     Int      @default(0)
  totalDownloads Int      @default(0)
  faceSearches   Int      @default(0)

  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: Cascade)
  action    String
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId, action])
}